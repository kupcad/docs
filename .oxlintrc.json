{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "oxc", "unicorn", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    // A stylesheet, and a page's script, are imported for what they do to the page
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "**/scripts/*.js"] }]
  },
  "env": {
    "es2024": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["dist/**", ".astro/**"]
}
