---
// The header's links out: the website (kupcad.org), then Starlight's social links. Each opens in
// a new tab as Markdown's external links do (src/plugins/external-links.mjs); a social link's
// `rel` keeps Starlight's `me` and adds noopener noreferrer.
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';
import { WEBSITE } from '../links.mjs';

const links = config.social || [];
---

<a href={WEBSITE} target="_blank" rel="noopener noreferrer" class="website sl-flex">kupcad.org</a>
{
	links.map(({ label, href, icon }) => (
		<a {href} target="_blank" rel="me noopener noreferrer" class="sl-flex">
			<span class="sr-only">{label}</span>
			<Icon name={icon} />
		</a>
	))
}

<style>
	@layer starlight.core {
		a {
			color: var(--sl-color-text-accent);
			padding: 0.5em;
			margin: -0.5em;
		}
		a:hover {
			color: var(--sl-color-white);
		}
		.website {
			align-items: center;
			font-size: var(--sl-text-sm);
			text-decoration: none;
			white-space: nowrap;
		}
	}
</style>
