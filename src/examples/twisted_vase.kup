# @title Twisted vase
# @description A faceted vase, its sides twisted as they rise and flaring at the top: one sketch, extruded with a twist

height = param(:height, default: 120, validate: { min: 40, max: 250 }, unit: "mm", title: "Height")
radius = param(
  :radius,
  default: 35,
  validate: { min: 15, max: 80 },
  unit: "mm",
  title: "Radius at the base",
)
sides = param(:sides, default: 7, validate: { min: 3, max: 24 }, step: 1, title: "Sides")
twist = param(
  :twist,
  default: 120,
  validate: { min: -360, max: 360 },
  step: 5,
  unit: "°",
  title: "Twist",
)
flare = param(
  :flare,
  default: 1.4,
  validate: { min: 0.6, max: 2.5 },
  step: 0.1,
  title: "Flare",
  description: "The top's size against the base's",
)
wall = param(
  :wall,
  default: 2.4,
  validate: { min: 1.2, max: 5 },
  step: 0.4,
  unit: "mm",
  title: "Wall",
)
floor = param(:floor, default: 3, validate: { min: 1, max: 10 }, unit: "mm", title: "Floor")

# The outline, a regular polygon, and the same outline the wall inside it: each extruded with
# the same twist and flare, so the wall stays even all the way up. A slice every few
# millimetres keeps the twisting sides smooth.
outline = regular_polygon(sides, r: radius)
outside = outline.extrude(height, twist: twist, scale: flare, slices: height / 4)
inside = outline
  .offset(-wall)
  .extrude(height, twist: twist, scale: flare, slices: height / 4)
  .translate(z: floor)

puts("Holds #{(inside.volume / 1000).round} ml")

(outside - inside).named("vase").material(color: "#3A7D8C")
