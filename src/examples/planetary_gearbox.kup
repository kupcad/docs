# @title Planetary gearbox
# @description A sun gear, its planets and the ring around them, meshed: involute spur gears to print

pitch_diameter = param(
  :pitch_diameter,
  default: 60,
  validate: { min: 30, max: 200 },
  unit: "mm",
  group: "Gearbox",
  title: "Ring pitch diameter",
  description: "The ring gear's pitch circle: the size of every tooth follows from it",
)
sun_teeth = param(
  :sun_teeth,
  default: 12,
  validate: { min: 12, max: 60 },
  step: 1,
  group: "Gearbox",
  title: "Sun teeth",
)
planet_teeth = param(
  :planet_teeth,
  default: 12,
  validate: { min: 12, max: 60 },
  step: 1,
  group: "Gearbox",
  title: "Planet teeth",
)
planet_count = param(
  :planet_count,
  default: 3,
  validate: { min: 1, max: 8 },
  step: 1,
  group: "Gearbox",
  title: "Planets",
)

thickness = param(
  :thickness,
  default: 10,
  validate: { min: 2, max: 50 },
  unit: "mm",
  group: "Gears",
  title: "Thickness",
)
backlash = param(
  :backlash,
  default: 0.2,
  validate: { min: 0, max: 1 },
  step: 0.05,
  unit: "mm",
  group: "Gears",
  title: "Backlash",
  description: "The play between meshed teeth, so printed gears turn freely",
)
sun_bore = param(
  :sun_bore,
  default: 5,
  validate: { min: 0, max: 30 },
  unit: "mm",
  group: "Shafts",
  title: "Sun shaft",
)
planet_bore = param(
  :planet_bore,
  default: 3,
  validate: { min: 0, max: 30 },
  unit: "mm",
  group: "Shafts",
  title: "Planet pins",
)
rim = param(
  :rim,
  default: 7.5,
  validate: { min: 3, max: 30 },
  unit: "mm",
  group: "Shafts",
  title: "Ring rim",
  description: "From the ring's pitch circle to its outside",
)

# At 25° a 12-tooth gear meshes without undercut (at 20° it needs 17 teeth)
PRESSURE_ANGLE = 25
CAD.config(resolution: { segments: 120 })

# A planet spans the sun and the ring, so the ring has the sun's teeth and two planets' more
ring_teeth = sun_teeth + 2 * planet_teeth
# The module: every gear has teeth of one size, so they mesh
gear_module = pitch_diameter / ring_teeth
pitch = Math::PI * gear_module
orbit = (sun_teeth + planet_teeth) * gear_module / 2

# Evenly spaced planets mesh with the sun and the ring at once only when the two gears' teeth
# divide by them; and neighbours must clear each other's tips
meshing_teeth = sun_teeth + ring_teeth
unless (meshing_teeth / planet_count).integer?
  warn(
    "#{planet_count} planets can't mesh evenly spaced: #{meshing_teeth} teeth don't divide by them",
  )
end
neighbours_apart = 2 * orbit * Math.sind(180.0 / planet_count)
if planet_count > 1 && neighbours_apart <= (planet_teeth + 2) * gear_module
  warn("#{planet_count} planets don't fit around the sun: neighbours overlap")
end

# How far round an involute has turned (in degrees) where it reaches radius r, from where it
# leaves the base circle
def involute(base_r, r)
  angle = Math.acosd(base_r / r)
  Math.tand(angle) * 180 / Math::PI - angle
end

# A gear's outline: `teeth` teeth, the first centred on +x, each `width` wide at the pitch circle,
# with involute flanks from the root circle to the tip (straight in below the base circle, where
# no involute is), a little of the tip circle across each tooth and of the root circle between
# them. The ring's hollow is one too: its "teeth" are the ring's tooth spaces.
def gear_outline(teeth, width, root_r, tip_r)
  pitch_r = teeth * gear_module / 2
  base_r = pitch_r * Math.cosd(PRESSURE_ANGLE)
  # The angle from a tooth's middle to its flank at the pitch circle, and at radius r
  half = width / pitch_r * 90 / Math::PI + involute(base_r, pitch_r)
  flank = ->(r) { half - (r > base_r ? involute(base_r, r) : 0) }
  start = [root_r, base_r].max
  radii = (0..8).map { |i| start + (tip_r - start) * i / 8.0 }
  if root_r < start
    radii.unshift(root_r)
  end
  at = ->(r, angle) { [r * Math.cosd(angle), r * Math.sind(angle)] }

  points = (0...teeth)
    .to_a
    .flat_map do |k|
      middle = k * 360.0 / teeth
      gap_from = middle + flank.call(root_r)
      gap_to = middle + 360.0 / teeth - flank.call(root_r)
      radii.map { |r| at.call(r, middle - flank.call(r)) } +
        radii.reverse.map { |r| at.call(r, middle + flank.call(r)) } +
        (1..3).map { |i| at.call(root_r, gap_from + (gap_to - gap_from) * i / 4.0) }
    end
  polygon(points)
end

# An external gear: its teeth half a pitch wide less the backlash, their tips a module out from
# the pitch circle and their roots a quarter more in, for clearance; and its shaft's bore
def spur_gear(teeth, bore)
  pitch_r = teeth * gear_module / 2
  outline = gear_outline(
    teeth,
    pitch / 2 - backlash / 2,
    pitch_r - 1.25 * gear_module,
    pitch_r + gear_module,
  )
  if bore > 0
    outline = outline - circle(d: bore)
  end
  outline.extrude(thickness)
end

# The ring: a disc with a hollow of the ring's tooth spaces, half a pitch wide plus the backlash,
# reaching a quarter module past the planets' tips and stopping a module short of the pitch circle
def ring_gear
  pitch_r = ring_teeth * gear_module / 2
  hollow = gear_outline(
    ring_teeth,
    pitch / 2 + backlash / 2,
    pitch_r - gear_module,
    pitch_r + 1.25 * gear_module,
  )
  # Turned so a ring tooth faces the first planet's tooth space on +x, as the planets below
  # need: a tooth at 180° × planet / ring teeth, the spaces half a tooth on
  phase = 180.0 * planet_teeth / ring_teeth + 180.0 / ring_teeth
  ring = circle(r: pitch_r + rim) - hollow.rotate(phase)
  ring.extrude(thickness)
end

# Each planet meshes where it touches the sun and the ring: its tooth spaces face their teeth.
# The sun has a tooth on +x; a planet at `angle` round the orbit turns by that angle times
# (sun + planet) / planet, and half a turn less half a tooth, to meet it.
sun = spur_gear(sun_teeth, sun_bore).named("sun gear").material(color: "#B22222")
planet = spur_gear(planet_teeth, planet_bore).named("planet gear").material(color: "#DAA520")
planets = (0...planet_count).map do |i|
  angle = i * 360.0 / planet_count
  spin = angle * (sun_teeth + planet_teeth) / planet_teeth + 180 - 180.0 / planet_teeth
  planet.rotate(spin).translate(orbit * Math.cosd(angle), orbit * Math.sind(angle), 0)
end
ring = ring_gear.named("ring gear").material(color: "#708090")

assemble(name: "Planetary gearbox", parts: [ring, sun] + planets)
